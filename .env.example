# Copy this file to ".env" and fill in your real values before running the server.

# Port the server runs on (most hosts set this automatically)
PORT=5000

# Secret used to sign login tokens - change this to any long random string
JWT_SECRET=change_this_to_a_long_random_secret_key

# Supabase database connection
# Get these from your Supabase project: Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# The public web address of your site (used in email links).
# Use http://localhost:5000 while testing locally, and your real
# Railway/custom domain once live.
APP_URL=http://localhost:5000

# Google Sign-In (optional) - get a Client ID from
# https://console.cloud.google.com/apis/credentials
# Leave blank to hide the Google sign-in button.
GOOGLE_CLIENT_ID=

# Resend (optional) - for confirmation and password-reset emails.
# Get a free API key from https://resend.com/api-keys
# Leave blank to skip sending emails (accounts still work, just unverified).
RESEND_API_KEY=
EMAIL_FROM=AL AZEEM Store <onboarding@resend.dev>

# First admin account - created automatically the first time the server starts
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password

# Razorpay keys (for online UPI / card payments)
# Get these free from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Store details shown on the site
STORE_NAME=AL AZEEM TRADERS
STORE_PHONE=+91XXXXXXXXXX
